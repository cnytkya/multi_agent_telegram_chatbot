# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# LLM Provider — set to: anthropic | gemini | ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
LLM_MODEL=claude-sonnet-4-6

# Ollama (only needed when LLM_PROVIDER=ollama)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://ollama:11434        # Docker Compose içinde
# OLLAMA_BASE_URL=http://localhost:11434     # Local geliştirme

# Database
DATABASE_URL=postgresql+asyncpg://bot:bot@db:5432/bot

# App
LOG_LEVEL=INFO

# Lisans — github.com/cnytkya ile iletişime geç
LICENSE_KEY=
